{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [".oxlintrc-base.json"],
  "ignorePatterns": [
    "dist/*",
    "node_modules/**/*",
    "bin/*",
    "config/*",
    "data/*",
    "docker/*",
    "docs/*",
    "generators/*",
    "lib/*",
    "mapp/*",
    "mtls-proxy/*",
    "resources/*",
    "backend/main/__tests__/*",
    "frontend/public/",
    "frontend/src/assets/",
    "webpack.*.js"
  ]
}
