{
  "compilerOptions": {
    "target": "esnext",
    "outDir": "./dist",
    "module": "commonjs",
    "declaration": true,
    "declarationDir": "./types",
    "jsx": "react",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "removeComments": true,
    "noLib": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "sourceMap": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@nestjsx/crud-request": ["./lib/@nestjsx/crud-request"],
      "@nestjsx/crud-typeorm": ["./lib/@nestjsx/crud-typeorm"],
      "@nestjsx/crud": ["./lib/@nestjsx/crud"],
      "@nestjsx/crud/*": ["./lib/@nestjsx/crud/*"]
    }
  },
  "exclude": [
    "node_modules",
    "**/node_modules",
    "docs",
    "resources",
    "generators",
    "dist",
    "package",
    "sds-eng-showroom-**"
  ]
}
